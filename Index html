
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>DisiCreator AI</title>
<style>
:root {
  --bg:#0b0a13;
  --panel:#151321;
  --line:#302943;
  --purple:#9b75ff;
  --pink:#ec73c5;
  --text:#f7f4ff;
  --muted:#aaa3bd;
}
* { box-sizing:border-box; }
body {
  margin:0; padding:20px;
  font-family:Arial,sans-serif;
  background:var(--bg); color:var(--text);
}
.container { max-width:900px; margin:auto; }
header { text-align:center; padding:20px 0 30px; }
.logo { font-size:28px; font-weight:bold; }
.logo span { color:var(--purple); }
header p { color:var(--muted); }
.hero,.panel {
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:16px;
  padding:22px;
  margin-bottom:18px;
}
.hero {
  background:linear-gradient(130deg,#291b45,#171222);
}
h1 { font-size:30px; margin:0 0 12px; }
h2 { font-size:19px; margin-top:0; }
p { line-height:1.6; }
label {
  display:block; margin:15px 0 7px;
  font-size:13px; font-weight:bold;
}
input,select,textarea {
  width:100%; padding:13px;
  border-radius:9px;
  border:1px solid var(--line);
  background:#0d0c16; color:white;
  font-size:15px;
}
textarea { min-height:90px; resize:vertical; }
button {
  border:0; border-radius:9px;
  padding:12px 16px; cursor:pointer;
  font-weight:bold; font-size:14px;
}
.primary {
  width:100%; margin-top:18px;
  background:linear-gradient(100deg,var(--purple),var(--pink));
  color:white;
}
.secondary {
  background:#282039; color:white;
  border:1px solid var(--line);
}
.result {
  border:1px solid var(--line);
  background:#0e0c17;
  border-radius:10px;
  padding:14px; margin:12px 0;
}
.result-title {
  display:flex; align-items:center;
  justify-content:space-between; gap:8px;
  color:#c8b4ff; font-size:12px;
  font-weight:bold; margin-bottom:10px;
}
.result-text {
  white-space:pre-wrap; overflow-wrap:anywhere;
  line-height:1.6; font-size:14px;
}
.actions { display:flex; gap:10px; flex-wrap:wrap; }
.small { color:var(--muted); font-size:12px; }
#output { display:none; }
#savedList .result { margin-top:10px; }
footer { text-align:center; color:var(--muted); padding:20px 0; font-size:12px; }
@media(min-width:700px) {
  .form-grid { display:grid; grid-template-columns:1fr 1fr; gap:0 15px; }
}
</style>
</head>
<body>
<div class="container">

<header>
  <div class="logo">Disi<span>Creator</span> AI ✦</div>
  <p>Your creative studio for TikTok and YouTube Shorts</p>
</header>

<section class="hero">
  <h1>Turn your ideas into content.</h1>
  <p>Create video hooks, scripts, AI visual prompts, captions and hashtags in one place.</p>
</section>

<section class="panel">
  <h2>✦ Create your content</h2>

  <form id="creatorForm">
    <label for="topic">What's your video about?</label>
    <textarea id="topic" placeholder="Example: A mysterious man discovers a secret door..." required></textarea>

    <div class="form-grid">
      <div>
        <label for="niche">Content niche</label>
        <select id="niche">
          <option>Horror Stories</option>
          <option>Gaming</option>
          <option>AI Transformations</option>
          <option>Comedy</option>
          <option>Motivation</option>
          <option>Product Advertising</option>
          <option>Education</option>
        </select>
      </div>
      <div>
        <label for="platform">Platform</label>
        <select id="platform">
          <option>TikTok</option>
          <option>YouTube Shorts</option>
          <option>Instagram Reels</option>
        </select>
      </div>
      <div>
        <label for="language">Language</label>
        <select id="language">
          <option value="en">American English</option>
          <option value="darija">Moroccan Darija</option>
          <option value="fr">French</option>
          <option value="ar">Arabic</option>
        </select>
      </div>
      <div>
        <label for="duration">Video duration</label>
        <select id="duration">
          <option>15 seconds</option>
          <option selected>30 seconds</option>
          <option>60 seconds</option>
        </select>
      </div>
    </div>

    <label for="style">Video style</label>
    <select id="style">
      <option>Cinematic and engaging</option>
      <option>Funny and relatable</option>
      <option>Mysterious and suspenseful</option>
      <option>Professional advertising</option>
      <option>Viral and high-energy</option>
    </select>

    <button class="primary" type="submit">✦ Generate Content Pack</button>
    <p class="small">Demo version: generates sample templates in your browser. No AI API connected.</p>
  </form>
</section>

<section class="panel" id="output">
  <h2>Your Content Pack</h2>
  <div id="results"></div>
  <div class="actions">
    <button class="primary" id="saveBtn" type="button">＋ Save Idea</button>
    <button class="secondary" id="copyAllBtn" type="button">Copy Everything</button>
  </div>
</section>

<section class="panel">
  <h2>▤ My Saved Ideas</h2>
  <p class="small">Your ideas are saved in this browser on this device.</p>
  <div id="savedList"></div>
  <button class="secondary" id="clearBtn" type="button">Clear Saved Ideas</button>
</section>

<footer>© <span id="year"></span> DisiCreator AI · Creator Studio</footer>
</div>

<script>
const $ = id => document.getElementById(id);
let currentPack = null;
let saved = [];

try {
  saved = JSON.parse(localStorage.getItem("disicreator_ideas") || "[]");
  if (!Array.isArray(saved)) saved = [];
} catch (e) {
  saved = [];
}

$("year").textContent = new Date().getFullYear();

function escapeHTML(value) {
  return String(value).replace(/[&<>"']/g, c => ({
    "&":"&amp;", "<":"&lt;", ">":"&gt;",
    '"':"&quot;", "'":"&#39;"
  })[c]);
}

function makePack(topic, niche, platform, language, duration, style) {
  let hook, script, caption;

  if (language === "darija") {
    hook = "واش واجد تعرف السر؟ " + topic + " 👀";
    script =
      "0–3 ثواني: البداية المشوقة: " + hook +
      "\n3–10 ثواني: قدم الموضوع بطريقة بسيطة." +
      "\n10–" + duration + ": زيد التفاصيل بلقطات سريعة ومشوقة." +
      "\nالنهاية: سول الجمهور على الرأي ديالو.";
    caption = "شنو رأيك فهاد الفكرة؟ كتب لينا فالتعليقات 👇";
  } else if (language === "fr") {
    hook = "Attends… tu dois voir ça ! 👀";
    script =
      "0–3 s : Accroche : " + hook +
      "\n3–10 s : Présente le sujet : " + topic +
      "\nEnsuite : Montre les détails avec des plans dynamiques." +
      "\nTermine par une question pour encourager les commentaires.";
    caption = "Tu en penses quoi ? Dis-le en commentaire 👇";
  } else if (language === "ar") {
    hook = "انتظر، عليك مشاهدة هذه الفكرة! 👀";
    script =
      "0–3 ثوانٍ: البداية: " + hook +
      "\n3–10 ثوانٍ: تقديم الموضوع: " + topic +
      "\nبقية الفيديو: عرض التفاصيل بلقطات متتابعة." +
      "\nالنهاية: سؤال يشجع الجمهور على التعليق.";
    caption = "ما رأيك؟ شاركنا رأيك في التعليقات 👇";
  } else {
    hook = "WAIT… You need to see this! " + topic + " 👀";
    script =
      "0–3s — HOOK: " + hook +
      "\n3–10s — SETUP: Introduce the idea: " + topic +
      "\n10–" + duration + " — PAYOFF: Show the most interesting details using fast, clear shots." +
      "\nFINAL SHOT — CTA: “What would you do? Comment below and follow for more.”";
    caption = "Would you try this? 👀 Comment below and follow for more " +
      niche.toLowerCase() + " content.";
  }

  const visual =
    "Create a " + duration + " vertical 9:16 video for " + platform +
    ". Topic: " + topic +
    ". Niche: " + niche +
    ". Visual style: " + style +
    ". Strong opening hook, realistic details, cinematic lighting, smooth camera movement, " +
    "clear storytelling, consistent characters, engaging pacing and a satisfying ending. " +
    "Avoid watermarks, unwanted text and random logos.";

  const hashtags = [
    "#" + niche.replace(/[^a-z0-9]/gi, ""),
    "#" + platform.replace(/[^a-z0-9]/gi, ""),
    "#ContentCreator", "#VideoIdeas", "#DisiCreator"
  ];

  return {hook, script, visual, caption, hashtags, topic, niche};
}

function renderPack(pack) {
  const blocks = [
    ["Hook", "hook", pack.hook],
    ["Video Script", "script", pack.script],
    ["AI Visual Prompt", "visual", pack.visual],
    ["Caption", "caption", pack.caption],
    ["Hashtags", "hashtags", pack.hashtags.join(" ")]
  ];

  $("results").innerHTML = blocks.map(([title, key, value]) => `
    <div class="result">
      <div class="result-title">
        <span>${title}</span>
        <button class="secondary" type="button" data-copy="${key}">Copy</button>
      </div>
      <div class="result-text">${escapeHTML(value)}</div>
    </div>
  `).join("");

  $("results").querySelectorAll("[data-copy]").forEach(button => {
    button.addEventListener("click", () => {
      const key = button.dataset.copy;
      copyText(key === "hashtags" ? pack.hashtags.join(" ") : pack[key]);
    });
  });

  $("output").style.display = "block";
}

function copyText(text) {
  if (navigator.clipboard && window.isSecureContext) {
    navigator.clipboard.writeText(text)
      .then(() => alert("Copied!"))
      .catch(() => window.prompt("Copy this text:", text));
  } else {
    window.prompt("Copy this text:", text);
  }
}

$("creatorForm").addEventListener("submit", event => {
  event.preventDefault();

  currentPack = makePack(
    $("topic").value.trim(),
    $("niche").value,
    $("platform").value,
    $("language").value,
    $("duration").value,
    $("style").value
  );

  renderPack(currentPack);
  $("output").scrollIntoView({behavior:"smooth", block:"start"});
});

function renderSaved() {
  if (!saved.length) {
    $("savedList").innerHTML = '<p class="small">No saved ideas yet. Create your first content pack above.</p>';
    return;
  }

  $("savedList").innerHTML = saved.map((item, index) => `
    <div class="result">
      <strong>${escapeHTML(item.topic)}</strong>
      <p class="small">${escapeHTML(item.niche)} · ${escapeHTML(item.platform || "")}</p>
      <div class="actions">
        <button class="secondary" type="button" data-open="${index}">View</button>
        <button class="secondary" type="button" data-delete="${index}">Delete</button>
      </div>
    </div>
  `).join("");

  $("savedList").querySelectorAll("[data-open]").forEach(button => {
    button.addEventListener("click", () => {
      currentPack = saved[Number(button.dataset.open)];
      renderPack(currentPack);
      $("output").scrollIntoView({behavior:"smooth"});
    });
  });

  $("savedList").querySelectorAll("[data-delete]").forEach(button => {
    button.addEventListener("click", () => {
      saved.splice(Number(button.dataset.delete), 1);
      persistSaved();
    });
  });
}

function persistSaved() {
  try {
    localStorage.setItem("disicreator_ideas", JSON.stringify(saved));
    renderSaved();
  } catch (e) {
    alert("Could not save. Check your browser storage settings.");
  }
}

$("saveBtn").addEventListener("click", () => {
  if (!currentPack) return;
  saved.unshift({...currentPack, platform:$("platform").value});
  persistSaved();
  alert("Idea saved on this device!");
});

$("copyAllBtn").addEventListener("click", () => {
  if (!currentPack) return;
  copyText(
    "HOOK\n" + currentPack.hook +
    "\n\nSCRIPT\n" + currentPack.script +
    "\n\nVISUAL PROMPT\n" + currentPack.visual +
    "\n\nCAPTION\n" + currentPack.caption +
    "\n\nHASHTAGS\n" + currentPack.hashtags.join(" ")
  );
});

$("clearBtn").addEventListener("click", () => {
  if (!confirm("Delete all saved ideas?")) return;
  saved = [];
  persistSaved();
});

renderSaved();
</script>
</body>
</html>
